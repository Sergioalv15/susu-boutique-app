    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.8",
    "babel-preset-expo": "~54.0.0",
    "eas-cli": "^23.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
